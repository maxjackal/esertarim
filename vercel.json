{
  "buildCommand": "echo 'No build command needed for static site'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' https://noxbjvyswcvxuqobalxl.supabase.co wss://noxbjvyswcvxuqobalxl.supabase.co https://cdn.jsdelivr.net; img-src 'self' data: blob:; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/kayit-ekle", "destination": "/pages/ledger-entry-create" },
    { "source": "/kayitlar", "destination": "/pages/ledger-entries" },
    { "source": "/defterler", "destination": "/pages/ledgers" },
    { "source": "/defter-detay", "destination": "/pages/ledger-details" },
    { "source": "/tahsilatlar", "destination": "/pages/collections" },
    { "source": "/acik-alacaklar", "destination": "/pages/open_receivables" },
    { "source": "/tahsilat-raporu", "destination": "/pages/collection_reports" },
    { "source": "/satici-raporu", "destination": "/pages/seller-report" },
    { "source": "/urunler", "destination": "/pages/products" },
    { "source": "/saticilar", "destination": "/pages/sellers" },
    { "source": "/alicilar", "destination": "/pages/buyers" },
    { "source": "/giris", "destination": "/pages/login" }
  ]
}
